---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { PHONES, FOOTER_PAGES, FUTURE } from "../data/site";
---
<footer class="site-footer surface-dark">
  <div class="container site-footer__grid">
    <Logo />
    <nav class="site-footer__nav" aria-label="Розділи сайту">
      <ul>
        {FOOTER_PAGES.map((p) => <li><FutureLink note={FUTURE}>{p}</FutureLink></li>)}
      </ul>
    </nav>
    <ul class="site-footer__phones">
      {PHONES.map((p) => <li><a class="text-link" href={p.href}>{p.label}</a></li>)}
    </ul>
    <p class="site-footer__copy muted">© 2018–2026 Top-master</p>
  </div>
</footer>
